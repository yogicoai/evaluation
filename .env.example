# ── MongoDB (이 파일을 복사해서 .env.local 로 저장 후 값 입력) ──
MONGODB_URI=mongodb+srv://...
# DB명 (기본 evaluation)
MONGODB_DB=evaluation

# ── 스태프/매출 연동 오프라인 서버 (deliveryOFF와 동일 서버, 미설정 시 기본값 사용) ──
# OFFLINE_API_BASE=https://port-0-realtime-lzgmwhc4d9883c97.sel4.cloudtype.app

# ── 개발자 마스터 비밀번호 ──
# 평가자 비밀번호(기본 2026)가 바뀌어도 모든 평가자 페이지에 접근할 수 있는 우회 비밀번호.
# 화면에는 어떤 안내도 표시되지 않는다. 미설정 시 마스터 로그인은 비활성화된다.
# MASTER_PASSWORD=
